    {
      "authorName": "pagnchanak",
      "categories": [
        "System"
      ],
      "changelog": "https://github.com/jaycee-h/android-system-tools/releases",
      "suggestedVersionCode": "10",
      "description": "System Tools is a personal toolbox for rooted Android devices (Magisk, KernelSU or APatch).\n\n* App Systemizer: turn user apps into system apps (priv-app or app) and de-systemize system apps,\n  keeping them as user apps or removing them completely. Everything lives in one systemless module\n  that applies on reboot and can be reverted.\n* Work Profile Apps: enable any installed app in the work profile or another user, no store needed.\n* Root Shell: run commands as root and read the output.\n* Material 3 Expressive design with wallpaper (Monet) colours.\n* Built-in update check for the Stable and Dev channels.\n\nNeeds root. Systemizing changes your system through a module, so use it at your own risk.",
      "issueTracker": "https://github.com/jaycee-h/android-system-tools/issues",
      "license": "Unknown",
      "sourceCode": "https://github.com/jaycee-h/android-system-tools",
      "summary": "Root toolbox for systemizing apps, work profile apps and a root shell",
      "webSite": "https://github.com/jaycee-h/android-system-tools",
      "added": 1793267947000,
      "packageName": "com.pagnchanak.systemtools",
      "lastUpdated": 1793267948000,
